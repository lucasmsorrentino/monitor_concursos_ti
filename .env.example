# =====================================================================
# TELEGRAM
# =====================================================================
# Token unico do bot (uma instancia pode enviar para varias areas/chats)
TELEGRAM_TOKEN=seu_token_telegram

# =====================================================================
# LLM — escolha UMA das tres opcoes abaixo (LLM_MODEL define o backend)
# =====================================================================

# --- Opcao 1: Ollama local (padrao, custo zero, usa CPU/GPU local) ---
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Opcao 2: API remota via LiteLLM (rapida e precisa, custo por token) ---
# Descomente o modelo e exporte a API key do provider correspondente.
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sua_api_key
# ...ou outros providers:
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sua_api_key
# LLM_MODEL=minimax/MiniMax-M2
# MINIMAX_API_KEY=sua_api_key
#
# --- Opcao 2b: z.ai (GLM), API paga por uso (recomendado em 10/2026) ---
# Chave em https://z.ai (API Keys). GLM-5.3-Flash: US$ 0,15 / 0,50 por 1M tokens
# (entrada / saida). O GLM-5.3-Flash sempre "pensa" e o padrao da API e
# reasoning_effort=max: lento e caro para extrair meia duzia de campos, entao
# use low. Valores aceitos pelo modelo: low | high | max.
# GLM-4.7-Flash e de graca (troque so o LLM_MODEL), com limite de taxa menor.
# LLM_MODEL=zai/glm-5.3-flash
# ZAI_API_KEY=sua_api_key
# LLM_REASONING_EFFORT=low
#
# --- Qualquer endpoint compativel com OpenAI ---
# LLM_MODEL=openai/<modelo>
# LLM_API_BASE=https://.../v1
# LLM_API_KEY=sua_api_key
# NAO recomendado com assinaturas feitas para agentes de codigo (OpenCode Go,
# GLM Coding Plan): os termos tratam trafego fora desse uso como abuso.
#
# Depois de trocar de modelo ou de chave, valide em segundos (sem varredura):
#   python main.py --testar-llm

# --- Opcao 3: Claude Code CLI (usa a assinatura local, custo marginal zero) ---
# Requer `claude` no PATH, autenticado via OAuth. Latencia alta (segundos).
# Aliases disponiveis: haiku (default), sonnet, opus.
# LLM_MODEL=claude-cli:haiku

# --- Configuracoes comuns (aplicam-se aos tres backends) ---
# Os nomes LLM_* sao os corretos (o backend em uso e o `claude -p`, nao o Ollama).
# Os OLLAMA_* seguem aceitos como alias legado; LLM_* ganha quando os dois existem.
LLM_TIMEOUT_S=120
LLM_RETRIES=2
LLM_RETRY_DELAY_S=2

# =====================================================================
# ALVOS DE MONITORAMENTO
# =====================================================================
# Modo multi-area (recomendado)
# IMPORTANTE: python-dotenv nao suporta multiline — JSON deve ficar em UMA linha
MONITOR_TARGETS_JSON=[{"area": "TI", "display_name": "Tecnologia da Informacao", "url": "https://blog.grancursosonline.com.br/concursos-ti/", "chat_ids": ["SEU_CHAT_ID"], "keywords_include": ["ti", "tecnologia", "informacao", "sistemas"], "keywords_exclude": ["sociologia", "artes", "pedagogia"]}, {"area": "EDUCACAO", "display_name": "Educacao", "url": "https://blog.grancursosonline.com.br/concursos-educacao/", "chat_ids": ["CHAT_ID_NAMORADA"], "keywords_include": [], "keywords_exclude": []}, {"area": "SOCIOLOGIA_ARTES", "display_name": "Sociologia, Artes e Licenciaturas", "url": "https://blog.grancursosonline.com.br/concursos-abertos/", "chat_ids": ["CHAT_ID_NAMORADA"], "keywords_include": ["sociologia", "antropologia", "artes", "licenciatura"], "keywords_exclude": []}]

# --- SEGUNDA FONTE: PCI Concursos por slug de cargo (por alvo) ---
# Campos opcionais dentro de cada objeto do MONITOR_TARGETS_JSON:
#
#   "pci_slugs": ["analista-de-sistemas", "tecnico-em-informatica"]
#   "pci_primeira_carga": "individual" | "resumo_uf" | "silencioso"
#
# pci_slugs: cargos a consultar em https://www.pciconcursos.com.br/cargos/<slug>.
# Lista vazia ou ausente desliga o PCI naquele alvo. O parse e deterministico
# (a pagina e estruturada), entao NAO gasta chamada de LLM.
#
# Por que existe: o blog do Gran cobre quase so concursos estaduais e federais
# de grande porte. Toda a camada municipal — prefeituras, camaras, consorcios
# intermunicipais, conselhos regionais, autarquias — era invisivel ao bot.
#
# pci_primeira_carga: o que fazer na PRIMEIRA vez que o PCI roda numa area,
# quando dezenas ou centenas de editais entram de uma vez.
#   individual  = um card por edital, com os botoes de seguir/ignorar (padrao)
#   resumo_uf   = uma mensagem por estado, listando os orgaos daquele UF
#   silencioso  = so semeia o banco, notifica a partir da segunda rodada
# Da segunda rodada em diante o fluxo e sempre o normal, um card por novidade.
# A deteccao e pelo banco (linhas com fonte='pci' na area), sem flag em arquivo.
#
# Slugs validados em 2026-08-08, com o numero de orgaos distintos que renderam:
#   TI (60):        analista-de-sistemas, tecnico-em-informatica,
#                   tecnologia-da-informacao, desenvolvedor, programador,
#                   seguranca-da-informacao, redes, suporte-tecnico
#   EDUCACAO (220): professor, pedagogo, professor-de-educacao-basica,
#                   supervisor-escolar, orientador-educacional
#   SOC/ARTES (56): professor-de-artes, professor-de-sociologia,
#                   professor-de-filosofia, arte-educador
# Cuidado com `professor`: sozinho lista mais de mil concursos.

# --- TERCEIRA FONTE: lista NACIONAL do PCI (por alvo) ---
#
#   "pci_nacional": true
#
# Le https://www.pciconcursos.com.br/concursos/nacional/, que e onde estatal
# federal aparece: Dataprev, Transpetro, Correios, BNDES. Padrao DESLIGADO.
#
# Por que existe: o concurso da Dataprev (1.823 vagas, 1.793 delas de Analista
# de TI, inscricoes de 06/07 a 06/08/2026) nao apareceu em NENHUMA das outras
# duas fontes enquanto esteve aberto — nem no artigo do Gran, nem nos slugs de
# cargo do PCI. As duas tem o mesmo ponto cego, e esta pagina e o conserto.
#
# Custo: a listagem tem uma dezena de itens e a coluna de cargos costuma dizer
# so "Vários Cargos", entao quem decide a area e a LLM — UMA chamada por item
# NOVO. Item ja no banco sai deterministico, e item julgado fora da area fica
# registrado por 30 dias (data/pci_nacional_descartados.json) pra nao ser
# reavaliado todo dia. Em regime, isso e zero chamada por rodada.

# --- QUARTA FONTE: servidor MCP do PCI + CONFIG POR AREA (8 chaves) ---
#
# Chaves opcionais dentro de cada objeto do MONITOR_TARGETS_JSON. Todas tem
# padrao seguro: area sem nenhuma delas nao muda em nada o comportamento de
# hoje. Valor invalido loga aviso e cai no padrao (fail-open), e lista vazia
# explicita e respeitada ("ninguem isento"), diferente de chave ausente.
#
#   "pci_mcp": false               liga a porta do servidor MCP do PCI
#   "pci_mcp_cargos": []           termos de busca por cargo; porta ligada sem
#                                  termo e erro de config (a porta e devolvida
#                                  desligada: seria fonte morta)
#   "filtro_salarial": "desligado" "desligado" ou "ativo": a elegibilidade
#                                  (avalia so item de porta que traz regiao)
#   "corte_fora_sul": 0            piso de teto exigido fora do Sul (float)
#   "ufs_sem_corte": ["PR","SC","RS"]  UFs que nao passam pelo corte
#   "esferas_sem_corte": ["federal"]   esferas isentas do corte
#   "cargos_total_inflado": 10     acima desse total de cargos, municipal
#                                  fora do Sul e considerado inflado
#   "resumo_filtrados": "nunca"    "nunca" ou "semanal": resumo dos filtrados
#
# Aviso de configuracao: pci_mcp ligado junto com pci_slugs ou pci_nacional
# so AVISA — as portas de HTML sao reserva da porta do MCP (ADR-0001) e
# rodar as duas duplica trabalho na mesma rodada. Nada e desligado.
#
# Exemplo completo da area TI — porta do MCP ligada, filtro ativo, corte
# 10000 e os 13 termos de cargo (medidos em 22/11/2026: 108 concursos
# distintos de TI). E uma linha so (dotenv nao suporta multiline):
#
# MONITOR_TARGETS_JSON=[{"area": "TI", "display_name": "Tecnologia da Informacao", "url": "https://blog.grancursosonline.com.br/concursos-ti/", "chat_ids": ["SEU_CHAT_ID"], "keywords_include": ["ti", "tecnologia", "informacao", "sistemas"], "keywords_exclude": ["sociologia", "artes", "pedagogia"], "pci_mcp": true, "pci_mcp_cargos": ["analista de sistemas", "tecnologia da informacao", "desenvolvedor", "programador", "tecnico em informatica", "informatica", "analista de dados", "ciencia da computacao", "banco de dados", "redes", "suporte tecnico", "computacao", "software"], "filtro_salarial": "ativo", "corte_fora_sul": 10000, "ufs_sem_corte": ["PR", "SC", "RS"], "esferas_sem_corte": ["federal"], "cargos_total_inflado": 10, "resumo_filtrados": "semanal"}]

# --- SAUDE DAS FONTES ---
#
#   "dias_fonte_parada": 21
#
# Dias de conteudo IDENTICO antes de alertar que a fonte parou de ser
# atualizada. Padrao 21. O alerta sai uma vez por dia, por fonte, e NAO marca
# a rodada como falha — pagina congelada nao se conserta com retry, se
# conserta trocando a URL do alvo.
#
# Por que existe: `blog.grancursosonline.com.br/concursos-ti/` nao e um feed, e
# um artigo curado. O `dateModified` dele esta travado em 12/06/2026 e ele
# devolveu os MESMOS 45 blocos de 06/07 a 09/09 — 89 dias. Nenhum edital
# publicado depois de 12/06 podia chegar por ali, e o bot reportava dia normal,
# porque o alerta de cegueira era agregado e o PCI trazia novidade.
# O estado fica em data/saude_fontes.json.

# Nota sobre alvos FILTRADOS em paginas genericas (ex: SOCIOLOGIA_ARTES acima):
# com keywords_include preenchido, "0 concursos validos" e tratado como dia
# quieto (heartbeat), nao como falha de varredura. O alerta de cegueira so
# dispara se a pagina nao entregar bloco nenhum. O diagnostico POR FONTE
# (acima) e independente disso e continua valendo.

# Modo legado (single-area) — usado apenas se MONITOR_TARGETS_JSON estiver ausente
# URL_ALVO=https://blog.grancursosonline.com.br/concursos-ti/
# TELEGRAM_CHAT_ID=seu_chat_id
# KEYWORDS_INCLUDE=ti,tecnologia,informacao,sistemas
# KEYWORDS_EXCLUDE=sociologia,artes,pedagogia
# As oito chaves por area (quadro acima) tambem valem como variaveis:
# PCI_MCP=true
# PCI_MCP_CARGOS=analista de sistemas, informatica
# FILTRO_SALARIAL=ativo
# CORTE_FORA_SUL=10000
# UFS_SEM_CORTE=PR,SC,RS
# ESFERAS_SEM_CORTE=federal
# CARGOS_TOTAL_INFLADO=10
# RESUMO_FILTRADOS=semanal

# =====================================================================
# AGENDAMENTO
# =====================================================================
# Nao usado pelo main.py (que roda uma vez e sai). Agendamento diario e
# feito pelo sistema operacional:
#   Windows: scripts/install_schedule.ps1 (Task Scheduler, com catch-up)
#   Linux:   scripts/install_schedule.sh  (cron, 1 run/dia de madrugada, sem catch-up)
# HORARIO_EXECUCAO=03:00
