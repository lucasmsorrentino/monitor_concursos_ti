# =====================================================================
# TELEGRAM
# =====================================================================
# Token unico do bot (uma instancia pode enviar para varias areas/chats)
TELEGRAM_TOKEN=seu_token_telegram

# =====================================================================
# LLM — escolha UMA das tres opcoes abaixo (LLM_MODEL define o backend)
# =====================================================================

# --- Opcao 1: Ollama local (padrao, custo zero, usa CPU/GPU local) ---
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Opcao 2: API remota via LiteLLM (rapida e precisa, custo por token) ---
# Descomente o modelo e exporte a API key do provider correspondente.
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sua_api_key
# ...ou outros providers:
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sua_api_key
# LLM_MODEL=minimax/MiniMax-M2
# MINIMAX_API_KEY=sua_api_key

# --- Opcao 3: Claude Code CLI (usa a assinatura local, custo marginal zero) ---
# Requer `claude` no PATH, autenticado via OAuth. Latencia alta (segundos).
# Aliases disponiveis: haiku (default), sonnet, opus.
# LLM_MODEL=claude-cli:haiku

# --- Configuracoes comuns (aplicam-se aos tres backends) ---
# Os nomes LLM_* sao os corretos (o backend em uso e o `claude -p`, nao o Ollama).
# Os OLLAMA_* seguem aceitos como alias legado; LLM_* ganha quando os dois existem.
LLM_TIMEOUT_S=120
LLM_RETRIES=2
LLM_RETRY_DELAY_S=2

# =====================================================================
# ALVOS DE MONITORAMENTO
# =====================================================================
# Modo multi-area (recomendado)
# IMPORTANTE: python-dotenv nao suporta multiline — JSON deve ficar em UMA linha
MONITOR_TARGETS_JSON=[{"area": "TI", "display_name": "Tecnologia da Informacao", "url": "https://blog.grancursosonline.com.br/concursos-ti/", "chat_ids": ["SEU_CHAT_ID"], "keywords_include": ["ti", "tecnologia", "informacao", "sistemas"], "keywords_exclude": ["sociologia", "artes", "pedagogia"]}, {"area": "EDUCACAO", "display_name": "Educacao", "url": "https://blog.grancursosonline.com.br/concursos-educacao/", "chat_ids": ["CHAT_ID_NAMORADA"], "keywords_include": [], "keywords_exclude": []}, {"area": "SOCIOLOGIA_ARTES", "display_name": "Sociologia, Artes e Licenciaturas", "url": "https://blog.grancursosonline.com.br/concursos-abertos/", "chat_ids": ["CHAT_ID_NAMORADA"], "keywords_include": ["sociologia", "antropologia", "artes", "licenciatura"], "keywords_exclude": []}]

# --- SEGUNDA FONTE: PCI Concursos (por alvo) ---
# Campos opcionais dentro de cada objeto do MONITOR_TARGETS_JSON:
#
#   "pci_slugs": ["analista-de-sistemas", "tecnico-em-informatica"]
#   "pci_primeira_carga": "individual" | "resumo_uf" | "silencioso"
#
# pci_slugs: cargos a consultar em https://www.pciconcursos.com.br/cargos/<slug>.
# Lista vazia ou ausente desliga o PCI naquele alvo. O parse e deterministico
# (a pagina e estruturada), entao NAO gasta chamada de LLM.
#
# Por que existe: o blog do Gran cobre quase so concursos estaduais e federais
# de grande porte. Toda a camada municipal — prefeituras, camaras, consorcios
# intermunicipais, conselhos regionais, autarquias — era invisivel ao bot.
#
# pci_primeira_carga: o que fazer na PRIMEIRA vez que o PCI roda numa area,
# quando dezenas ou centenas de editais entram de uma vez.
#   individual  = um card por edital, com os botoes de seguir/ignorar (padrao)
#   resumo_uf   = uma mensagem por estado, listando os orgaos daquele UF
#   silencioso  = so semeia o banco, notifica a partir da segunda rodada
# Da segunda rodada em diante o fluxo e sempre o normal, um card por novidade.
# A deteccao e pelo banco (linhas com fonte='pci' na area), sem flag em arquivo.
#
# Slugs validados em 2026-08-08, com o numero de orgaos distintos que renderam:
#   TI (60):        analista-de-sistemas, tecnico-em-informatica,
#                   tecnologia-da-informacao, desenvolvedor, programador,
#                   seguranca-da-informacao, redes, suporte-tecnico
#   EDUCACAO (220): professor, pedagogo, professor-de-educacao-basica,
#                   supervisor-escolar, orientador-educacional
#   SOC/ARTES (56): professor-de-artes, professor-de-sociologia,
#                   professor-de-filosofia, arte-educador
# Cuidado com `professor`: sozinho lista mais de mil concursos.

# Nota sobre alvos FILTRADOS em paginas genericas (ex: SOCIOLOGIA_ARTES acima):
# com keywords_include preenchido, "0 concursos validos" e tratado como dia
# quieto (heartbeat), nao como falha de varredura. O alerta de cegueira so
# dispara se a pagina nao entregar bloco nenhum.

# Modo legado (single-area) — usado apenas se MONITOR_TARGETS_JSON estiver ausente
# URL_ALVO=https://blog.grancursosonline.com.br/concursos-ti/
# TELEGRAM_CHAT_ID=seu_chat_id
# KEYWORDS_INCLUDE=ti,tecnologia,informacao,sistemas
# KEYWORDS_EXCLUDE=sociologia,artes,pedagogia

# =====================================================================
# AGENDAMENTO
# =====================================================================
# Nao usado pelo main.py (que roda uma vez e sai). Agendamento diario e
# feito pelo sistema operacional:
#   Windows: scripts/install_schedule.ps1 (Task Scheduler, com catch-up)
#   Linux:   scripts/install_schedule.sh  (cron, 1 run/dia de madrugada, sem catch-up)
# HORARIO_EXECUCAO=03:00
